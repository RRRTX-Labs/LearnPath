# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Database — local file SQLite by default. Production: Turso libsql:// URL + token.
TURSO_DATABASE_URL=file:./data/learnpath.db
TURSO_AUTH_TOKEN=

# OAuth — leave empty to hide the provider button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Admin (comma-separated emails)
ADMIN_EMAILS=

# Public links
NEXT_PUBLIC_GITHUB_URL=https://github.com/learnpath/learnpath
NEXT_PUBLIC_DISCORD_INVITE=https://discord.com
